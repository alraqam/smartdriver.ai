# Shared Postgres from ../_shared-infra (database + role created for this project).
DATABASE_URL="postgresql://smartdriverai:smartdriverai@localhost:5432/smartdriverai?schema=public"
PORT=3003
NODE_ENV=development

# Signs learner JWTs. Production MUST set a strong value (>=16 chars).
JWT_SECRET="smartdriverai-dev-secret"
JWT_EXPIRES_IN="30d"

# Browser origins allowed to call this API.
CORS_ORIGINS="http://localhost:5175,http://localhost:8082,http://localhost:4175"

# Eskiz SMS. Blank -> mock mode: no SMS is sent and the OTP is printed to the log.
ESKIZ_BASE_URL="https://notify.eskiz.uz/api"
ESKIZ_EMAIL=""
ESKIZ_PASSWORD=""
ESKIZ_FROM="4546"
# DEMO ONLY. While Eskiz is in mock mode, the OTP is also returned in the
# /auth/otp/request response and shown in the UI so a demo needs no log access.
# Ignored outside mock mode, and unreachable in production (the API refuses to
# boot there without Eskiz credentials). Set to false to suppress it anyway.
DEMO_SHOW_OTP="true"

# Anthropic. Blank -> mock mode: explanations and tutor replies are canned,
# so the whole app still works offline and in CI.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"
# Tutor-chat messages allowed per learner per day.
TUTOR_DAILY_LIMIT=30

# Grants admin to this phone at boot — the only way to mint the FIRST admin.
# Promote-only: it never demotes anyone, so clearing it after a redeploy does
# not silently strip access from whoever runs content. The account is created
# if it does not exist yet; they then sign in by OTP like anyone else.
ADMIN_PHONE=""
ADMIN_NAME=""
