# E2E tests run against their OWN database so a test run can never touch dev
# data. Created with:
#   docker exec shared-postgres psql -U postgres -c "CREATE DATABASE smartdriverai_test OWNER smartdriverai;"
DATABASE_URL="postgresql://smartdriverai:smartdriverai@localhost:5432/smartdriverai_test?schema=public"
NODE_ENV=test
JWT_SECRET="e2e-only-secret-not-used-anywhere-else"
JWT_EXPIRES_IN="1h"
# Both integrations stay mocked: the suite must not send SMS or spend money.
ESKIZ_EMAIL=""
ESKIZ_PASSWORD=""
ANTHROPIC_API_KEY=""
DEMO_SHOW_OTP="true"
ADMIN_PHONE=""
UPLOAD_DIR="./uploads-test"
