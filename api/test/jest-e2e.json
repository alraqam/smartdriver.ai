{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": "..",
  "roots": [
    "<rootDir>/test",
    "<rootDir>/src"
  ],
  "testRegex": "test/.*\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.ts$": "ts-jest"
  },
  "testEnvironment": "node",
  "setupFiles": [
    "<rootDir>/test/env.ts"
  ],
  "modulePathIgnorePatterns": [
    "<rootDir>/dist/",
    "<rootDir>/uploads"
  ],
  "testPathIgnorePatterns": [
    "<rootDir>/node_modules/",
    "<rootDir>/dist/"
  ],
  "testTimeout": 30000,
  "maxWorkers": 1
}
