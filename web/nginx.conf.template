server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # Hashed filenames, so these can be cached hard.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # index.html must never be cached, or a deploy leaves browsers pointing at
    # asset filenames that no longer exist.
    location = /index.html {
        add_header Cache-Control "no-cache, must-revalidate";
    }

    # Same reasoning, one level up: a stale service worker keeps serving a stale
    # index.html, and the phone never sees the deploy at all. Browsers already
    # cap worker staleness at 24h, but 24h of a bad deploy is 24h too many.
    location = /sw.js {
        add_header Cache-Control "no-cache, must-revalidate";
    }

    location /api/ {
        # Substituted at container start by the nginx image's
        # 20-envsubst-on-templates.sh. Defaults to the docker-compose service
        # name; set API_UPSTREAM wherever the API answers to something else
        # (EasyPanel and Kubernetes both name services differently, and a
        # hardcoded host here is a deploy that silently 502s).
        #
        # Only names that exist in the environment are substituted, so nginx's
        # own $host and $remote_addr below are left alone.
        proxy_pass http://${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # The tutor answer is a server-sent-event stream. Without these three,
        # nginx buffers the whole response and the learner stares at a spinner
        # until the answer is completely finished.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
